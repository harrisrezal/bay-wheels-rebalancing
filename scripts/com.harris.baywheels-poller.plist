<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.harris.baywheels-poller</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>__REPO__/poller.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!-- Every 5 minutes. Feed ttl is 60s, so this samples 1 in 5 refreshes: enough
         resolution for starvation detection without hammering Lyft's endpoint. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Fire once at load so collection starts immediately, not in 5 minutes. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__REPO__/logs/poller.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/poller.err</string>
</dict>
</plist>
